#!/bin/sh
# Garde-fou 50cc LIFE : refuse tout fichier de plus de 10 Mo dans un commit.
# Git garde chaque version pour toujours : un gros binaire alourdirait le
# dépôt définitivement (voir 50cc-life/docs/ARCHITECTURE.md, « Stockage gratuit »).
# Activation (une fois) : cd 50cc-life && npm run hooks:install

limit=$((10 * 1024 * 1024))

git diff --cached --name-only --diff-filter=AM | {
  fail=0
  while IFS= read -r file; do
    size=$(git cat-file -s ":$file" 2>/dev/null || echo 0)
    if [ "$size" -gt "$limit" ]; then
      mo=$(awk "BEGIN { printf \"%.1f\", $size / 1048576 }")
      echo "❌ $file : $mo Mo (max 10 Mo). Placez-le dans 50cc-life/assets-src/ (hors Git) ou compressez-le."
      fail=1
    fi
  done
  exit $fail
}
